# Radar reads RADAR_HOME/.env (default ~/.local/share/radar/.env) and ./.env. Real environment variables win.

# --- AI (optional: without a provider Radar still collects, filters by keywords and reads articles) ---
# Pick one. Unset RADAR_LLM: Anthropic if ANTHROPIC_API_KEY is set, else OpenAI if OPENAI_API_KEY is set.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1      # any OpenAI-compatible server (OpenRouter, Ollama, vLLM, LM Studio)
# RADAR_LLM=anthropic                                # anthropic | openai | codex | none
# RADAR_LLM_MODEL=claude-opus-5-5                    # summaries, Hot, source suggestions (required for openai)
# RADAR_LLM_FAST_MODEL=claude-haiku-5-5              # relevance triage; defaults to RADAR_LLM_MODEL

# Language of AI summaries and reasons (the interface is English).
# RADAR_LANGUAGE=English

# --- X (optional) ---
# Posts of the accounts in x-accounts.txt through SocialData (https://socialdata.tools), about $0.0002 per post.
# SOCIALDATA_API_KEY=

# --- Server ---
# RADAR_HOSTNAME=127.0.0.1
# RADAR_PORT=3200

# --- Files (defaults under RADAR_HOME) ---
# RADAR_HOME=~/.local/share/radar
# RADAR_STATE_DIR=$RADAR_HOME/state           # SQLite database and image cache
# RADAR_INTERESTS=$RADAR_HOME/interests.md    # what you care about, in your own words (Hot and suggestions read it)
# RADAR_FEEDS=$RADAR_HOME/feeds.opml          # your extra feeds (OPML), added once each
# RADAR_X_ACCOUNTS=$RADAR_HOME/x-accounts.txt # your X handles, one per line
