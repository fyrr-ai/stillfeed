# Stillfeed reads STILLFEED_HOME/.env (default ~/.local/share/stillfeed/.env) and ./.env. Real environment variables win.

# --- AI (optional: without a provider Stillfeed still collects, filters by keywords and reads articles) ---
# Pick one. Unset STILLFEED_LLM: Anthropic if ANTHROPIC_API_KEY is set, else OpenAI if OPENAI_API_KEY is set.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1      # any OpenAI-compatible server (OpenRouter, Ollama, vLLM, LM Studio)
# STILLFEED_LLM=anthropic                                # anthropic | openai | codex | none
# STILLFEED_LLM_MODEL=claude-opus-5-5                    # summaries, Hot, source suggestions (required for openai)
# STILLFEED_LLM_FAST_MODEL=claude-haiku-5-5              # relevance triage; defaults to STILLFEED_LLM_MODEL

# Language of AI summaries and reasons (the interface is English).
# STILLFEED_LANGUAGE=English

# --- X (optional) ---
# Posts of the accounts in x-accounts.txt through SocialData (https://socialdata.tools), about $0.0002 per post.
# SOCIALDATA_API_KEY=

# --- Server ---
# STILLFEED_HOSTNAME=127.0.0.1
# STILLFEED_PORT=3200

# --- Files (defaults under STILLFEED_HOME) ---
# STILLFEED_HOME=~/.local/share/stillfeed
# STILLFEED_STATE_DIR=$STILLFEED_HOME/state           # SQLite database and image cache
# STILLFEED_INTERESTS=$STILLFEED_HOME/interests.md    # what you care about, in your own words (Hot and suggestions read it)
# STILLFEED_FEEDS=$STILLFEED_HOME/feeds.opml          # your extra feeds (OPML), added once each
# STILLFEED_X_ACCOUNTS=$STILLFEED_HOME/x-accounts.txt # your X handles, one per line
